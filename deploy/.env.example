# ===================================================
# 听雨·禅意 3D 空间 (Zhuyu) 生产部署环境变量配置
# ===================================================

# 1. 容器与服务端口配置
APP_NAME=zhuyu-zen
APP_PORT=8080                 # 宿主机对外映射访问端口 (如 80、8080)
IMAGE_TAG=latest

# 2. 远程云服务器部署配置 (一键发布到此服务器)
SERVER_HOST=                  # 目标服务器 IP 或域名 (例如: 123.45.67.89)
SERVER_USER=root              # SSH 登录用户名 (默认: root)
SERVER_SSH_PORT=22            # SSH 登录端口 (默认: 22)
SERVER_DIR=/opt/zhuyu-zen     # 发布到服务器的目标文件夹路径 (例如: /opt/zhuyu-zen 或 ~/zhuyu)
